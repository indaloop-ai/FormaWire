@* The drawings of the guide and of the start page. Schematic: angles and offsets are exaggerated. *@

@switch (Kind)
{
  case "flusso":
    <svg class="fig-svg" viewBox="0 0 648 118" role="img" aria-label="i quattro passi">
      @for (int i = 0; i < 4; i++)
      {
        var x = 8 + i * 160;
        <rect class="figure-panel" x="@x" y="4" width="144" height="110" rx="6" />
        <g><text class="title" x="@(x + 8)" y="19">@Steps[i]</text></g>
        @if (i < 3) { <polygon class="arrow" points="@(x + 147),55 @(x + 156),59 @(x + 147),63" /> }
      }
      @* 1: the drawing as it comes, profile among frames and dimensions *@
      <g transform="translate(8,4)">
        <rect class="clutter" x="6" y="26" width="132" height="78" stroke-dasharray="4 3" />
        <line class="clutter" x1="36" y1="38" x2="80" y2="38" /><text class="dimtxt" x="50" y="34">12.5</text>
        <polyline class="gray" points="@Tool" />
      </g>
      @* 2: the tool profile picked *@
      <g transform="translate(168,4)">
        <rect class="faded" x="6" y="26" width="132" height="78" stroke-dasharray="4 3" />
        <polyline class="xy" points="@Tool" />
      </g>
      @* 3: + the second profile with the reliefs *@
      <g transform="translate(328,4)">
        <polyline class="uv" points="@Uv" />
        <polyline class="xy" points="@Tool" />
        <text class="note" x="8" y="104">spoglie = XY → UV</text>
      </g>
      @* 4: deformed, to cut *@
      <g transform="translate(488,4)">
        <polyline class="def-uv" points="@Squash(Uv)" />
        <polyline class="def-xy" points="@Squash(Tool)" />
        <text class="note" x="8" y="104">da tagliare</text>
      </g>
    </svg>
    break;

  case "origine":
    <svg class="fig-svg narrow" viewBox="0 0 330 150" role="img" aria-label="profilo nell'origine">
      <line class="guide" x1="60" y1="22" x2="60" y2="142" />
      <line class="guide" x1="40" y1="40" x2="290" y2="40" />
      <polyline class="xy" points="60,135 80,60 130,60 150,40 170,60 220,60 235,135" />
      <circle class="pt" cx="60" cy="135" r="3" /><circle class="pt" cx="150" cy="40" r="3" />
      <line class="axis-x" x1="60" y1="40" x2="88" y2="40" /><line class="axis-y" x1="60" y1="40" x2="60" y2="12" />
      <rect class="origin" x="56" y="36" width="8" height="8" />
      <text class="lbl" x="30" y="34">0,0</text>
      <text class="note" x="66" y="148">X0 = il punto più a sinistra</text>
      <text class="note" x="168" y="34">Y0 = il punto più alto</text>
    </svg>
    break;

  case "spoglia-sezione":
    <svg class="fig-svg narrow" viewBox="0 0 330 160" role="img" aria-label="spoglia in sezione">
      <polygon class="material" points="40,30 170,30 150,130 40,130" />
      <text class="note" x="62" y="86">materiale</text>
      <line class="plane-xy" x1="20" y1="30" x2="230" y2="30" /><text class="lbl xy-t" x="232" y="34">XY · Z 0</text>
      <line class="plane-uv" x1="20" y1="130" x2="230" y2="130" /><text class="lbl uv-t" x="232" y="134">UV · Z −5</text>
      <line class="cut" x1="170" y1="30" x2="150" y2="130" />
      <line class="guide" x1="170" y1="30" x2="170" y2="138" />
      <path class="arc-mount" d="M 170 78 A 48 48 0 0 1 160.6 77.1" />
      <text class="lbl" x="174" y="80">spoglia α</text>
      <circle class="xy-dot" cx="170" cy="30" r="3.5" /><circle class="uv-dot" cx="150" cy="130" r="3.5" />
      <line class="dim" x1="150" y1="146" x2="170" y2="146" /><line class="dim" x1="150" y1="140" x2="150" y2="152" /><line class="dim" x1="170" y1="140" x2="170" y2="152" />
      <text class="lbl" x="176" y="152">profondità · tan α</text>
      <line class="dim" x1="300" y1="30" x2="300" y2="130" /><line class="dim" x1="294" y1="30" x2="306" y2="30" /><line class="dim" x1="294" y1="130" x2="306" y2="130" />
      <text class="lbl" x="268" y="84">5 mm</text>
      <text class="note" x="100" y="20">il filo taglia da XY a UV</text>
    </svg>
    break;

  case "spoglia-direzione":
    <svg class="fig-svg narrow" viewBox="0 0 400 150" role="img" aria-label="direzione della spoglia">
      <text class="title" x="10" y="14">orizzontale / verticale (predefinita)</text>
      <line class="xy" x1="40" y1="135" x2="100" y2="35" /><line class="uv" x1="56" y1="135" x2="116" y2="35" />
      <line class="dim" x1="70" y1="85" x2="86" y2="85" /><polygon class="arrow" points="86,81 93,85 86,89" />
      <text class="lbl" x="100" y="90">di 5·tan α in X</text>
      <text class="note" x="110" y="128">materiale →</text>
      <text class="title" x="215" y="14">perpendicolare al lato</text>
      <line class="xy" x1="240" y1="135" x2="300" y2="35" /><line class="uv" x1="252" y1="142" x2="312" y2="42" />
      <line class="dim" x1="270" y1="85" x2="280" y2="91" /><polygon class="arrow" points="279,87 287,95 277,95" />
      <text class="lbl" x="296" y="96">5·tan α ⊥ al lato</text>
      <text class="note" x="300" y="128">raggi concentrici</text>
    </svg>
    break;

  case "correzione-frontale":
    <svg class="fig-svg narrow" viewBox="0 0 330 134" role="img" aria-label="correzione frontale">
      <polyline class="uv" points="40,102 70,32 160,32 190,62 250,62 270,102" />
      <polyline class="xy" points="40,110 70,40 160,40 190,70 250,70 270,110" />
      <line class="dim" x1="290" y1="70" x2="290" y2="50" /><polygon class="arrow" points="286,52 290,44 294,52" />
      <text class="lbl" x="276" y="86">+Y</text>
      <text class="note" x="20" y="16">montaggio 8° + correzione −2° = spoglia frontale 6°</text>
      <text class="lbl" x="40" y="128">tutto il profilo UV (azzurro) sale in Y di 5·tan 2° = 0,175 mm</text>
    </svg>
    break;

  case "strumenti":
    <div class="tool-figs">
      <div><svg viewBox="0 0 120 70"><line class="w" x1="20" y1="35" x2="60" y2="35" /><line class="w" x1="60" y1="10" x2="60" y2="60" /><line class="gone" x1="60" y1="35" x2="100" y2="35" /><circle class="click" cx="82" cy="35" r="4" /></svg><span><b>Taglia</b> clic sulla parte da togliere</span></div>
      <div><svg viewBox="0 0 120 70"><line class="w" x1="15" y1="35" x2="65" y2="35" /><line class="w" x1="100" y1="10" x2="100" y2="60" /><line class="new dash" x1="65" y1="35" x2="100" y2="35" /><circle class="click" cx="58" cy="35" r="4" /></svg><span><b>Estendi</b> fino al prossimo elemento</span></div>
      <div><svg viewBox="0 0 120 70"><line class="old" x1="75" y1="55" x2="95" y2="55" /><line class="old" x1="95" y1="55" x2="95" y2="35" /><line class="w" x1="15" y1="55" x2="75" y2="55" /><line class="w" x1="95" y1="35" x2="95" y2="8" /><path class="new" d="M 75 55 A 20 20 0 0 0 95 35" /></svg><span><b>Raccorda</b> raggio tra due linee</span></div>
      <div><svg viewBox="0 0 120 70"><line class="old" x1="75" y1="55" x2="95" y2="55" /><line class="old" x1="95" y1="55" x2="95" y2="35" /><line class="w" x1="15" y1="55" x2="75" y2="55" /><line class="w" x1="95" y1="35" x2="95" y2="8" /><line class="new" x1="75" y1="55" x2="95" y2="35" /></svg><span><b>Smusso</b> taglio dritto D</span></div>
      <div><svg viewBox="0 0 120 70"><polyline class="xy" points="15,62 38,22 82,22 105,62" /><polyline class="new" points="27,62 44,32 76,32 93,62" /><line class="dim" x1="60" y1="22" x2="60" y2="32" /></svg><span><b>Offset</b> copia parallela</span></div>
      <div><svg viewBox="0 0 120 70"><polyline class="w" points="20,62 32,24 60,24" /><line class="axis" x1="60" y1="6" x2="60" y2="66" /><polyline class="new" points="60,24 88,24 100,62" /></svg><span><b>Specchia</b> metà → simmetrico</span></div>
    </div>
    break;
}

@code {
  [Parameter] public string Kind { get; set; } = "";

  static readonly string[] Steps = { "1 · Disegno", "2 · Profilo XY", "3 · Secondo profilo", "4 · Deformazione" };
  // a tool tip as drawn: left flank, front, chamfer, front, right flank (material below)
  const string Tool = "12,96 34,48 80,48 96,62 118,62 124,96";
  const string Uv = "16,96 38,51 77,51 93,65 115,65 120,96";
  static string Squash(string pts) => string.Join(" ", pts.Split(' ').Select(p =>
  {
    var xy = p.Split(',');
    double y = double.Parse(xy[1], System.Globalization.CultureInfo.InvariantCulture);
    return xy[0] + "," + (96 - (96 - y) * 0.8).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
  }));
}
