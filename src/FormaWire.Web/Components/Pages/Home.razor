  [JSInvokable] public async Task OnKey(string key)
  {
    switch (key)
    {
      case "Escape":
        if (ShowHelp || ShowExport) { ShowHelp = false; ShowExport = false; StateHasChanged(); return; }
        if (_lockAngle is not null || _angleEntry) { _lockAngle = null; _angleEntry = false; _pendingLength = null; await JS.InvokeVoidAsync("editor.setLock", null); }
        else if (_anchor is not null || _stretchBox is not null || _filletFirst is not null || _chamferFirst is not null || _offsetId is not null) { await SetTool(Tool); }
        else if (Tool != "select") await SetTool("select");
        else Doc.Selection.Clear();
        Say("");
        break;
      case "Help": ShowHelp = !ShowHelp; StateHasChanged(); return;
      case "Enter":
        if (Tool is "line" or "measure" or "copy") await SetAnchor(null);
        else if (Tool == "mirror" && _anchor is { } ma && _lockAngle is { } ml) await MirrorAxis(ma, ma + Vec2.FromPolar(1, ml * Math.PI / 180));
        break;
      case "Delete": await Run(Doc.DeleteSelected); return;
      case "Undo": Doc.Undo(); PullInputs(); break;
      case "Redo": Doc.Redo(); PullInputs(); break;
      case "SelectAll": Doc.SelectAll(); break;
      case "Ortho": Ortho = !Ortho; await PushSnaps(); Say(Ortho ? "Orto acceso" : "Orto spento"); break;
      case "Polar": Polar = !Polar; await PushSnaps(); Say(Polar ? "Polare acceso: le linee si bloccano ogni 45°" : "Polare spento"); break;
      case "Snap": SnapsOn = !SnapsOn; await PushSnaps(); Say(SnapsOn ? "Snap ad oggetto acceso" : "Snap ad oggetto spento"); break;
      case "Grid":
        if (Mode3d) return;
        Grid = !Grid; await PushSnaps(); Say(Grid ? "Griglia 2D visibile" : "Griglia 2D nascosta"); break;
      default:
        if (key.StartsWith("tool:") && !Mode3d) await SetTool(key[5..]);
        break;
    }
    await Push();
  }

  // ------------------------------------------------------------------ the command line
  async Task CmdKey(KeyboardEventArgs e)
  {
    if (e.Key == "Escape") { Cmd = ""; await JS.InvokeVoidAsync("editor.blurCommand"); await OnKey("Escape"); return; }
    if (e.Key != "Enter") return;
    var text = Cmd.Trim(); Cmd = "";
    await ExecCommand(text);
  }

  async Task ExecCommand(string text)
  {
    if (text.Length == 0) { await OnKey("Enter"); return; }
    if (_angleEntry && TryNum(text, out var typedAngle)) { await LockAngle(typedAngle); return; }
    if (text.StartsWith('<') && _anchor is not null && TryNum(text[1..], out var lockTo)) { await LockAngle(lockTo); return; }
    if (Aliases.TryGetValue(text, out var t)) { await SetTool(t); return; }
    if (text.Equals("U", StringComparison.OrdinalIgnoreCase) || text.Equals("ANNULLA", StringComparison.OrdinalIgnoreCase)) { await OnKey("Undo"); return; }
    if (Tool == "fillet" && TryNum(text, out var r)) { FilletR = F(r); Say($"Raggio di raccordo {F(r)}"); return; }
    if (Tool == "chamfer" && TryChamfer(text, out var c1, out var c2)) { ChamferD = c1 == c2 ? F(c1) : $"{F(c1)};{F(c2)}"; Say($"Smusso {ChamferD} mm"); return; }
    if (Tool == "offset" && TryNum(text, out var od)) { OffsetD = F(od); Say($"Offset di {F(od)} mm"); return; }
    if (Tool == "extend" && TryNum(text, out var ext)) { ExtendBy = ext == 0 ? "" : F(ext); Say(ext == 0 ? "Estendi fino al prossimo elemento" : $"Estendi di {F(ext)} mm a ogni clic"); return; }
    if (Tool == "rotate" && _anchor is { } c && TryNum(text, out var ang)) { await SetAnchor(null); await RotateBy(c, ang); return; }
    if (Tool == "scale" && _anchor is { } sb && TryNum(text, out var k))
    {
      await SetAnchor(null);
      await Run(() => Doc.ScaleSelected(sb, k));
      if (!StatusIsError) Say($"Scalato ×{F(k, "0.######")} attorno a {sb}");
      return;
    }
    if (Tool == "circle" && _anchor is { } cc && TryNum(text, out var rad)) { await SetAnchor(null); _last = cc; await Run(() => Doc.AddCircle(cc, rad)); return; }
    var p = await ParsePoint(text);
    if (p is null) { Say($"'{text}' non capito: x,y · @dx,dy · @lunghezza<angolo · una lunghezza · o un comando (L, A, CE, SP, CP, RU, MI, SC, ST, TA, ES, SPE, RA, SM, OF, DI)", true); return; }
    if (Tool is "line" or "arc" or "circle" or "move" or "copy" or "rotate" or "mirror" or "scale" or "stretch" or "measure" or "origin") await OnPoint(p.Value.X, p.Value.Y, true, Tool);
    else Say("I punti scritti servono a Linea, Arco, Cerchio, Sposta, Copia, Ruota, Specchia, Scala, Stira, Misura e Origine", true);
  }

  /// <summary>x,y (or x;y with decimal commas) · @dx,dy relative · @len&lt;angle polar · a single length along the locked angle or the cursor direction.</summary>
  async Task<Vec2?> ParsePoint(string text)
  {
    bool rel = text.StartsWith('@'); if (rel) text = text[1..];
    var basePt = _anchor ?? _last ?? Vec2.Zero;
    int lt = text.IndexOf('<');
    if (lt > 0 && TryNum(text[..lt], out var len) && TryNum(text[(lt + 1)..], out var deg))
      return (rel ? basePt : Vec2.Zero) + Vec2.FromPolar(len, deg * Math.PI / 180);
    var parts = text.Contains(';') ? text.Split(';') : text.Split(',');
    if (parts.Length == 2 && TryNum(parts[0], out var x) && TryNum(parts[1], out var y))
      return (rel ? basePt : Vec2.Zero) + new Vec2(x, y);
    if (!rel && _anchor is { } a && TryNum(text, out var dist))
    {
      if (_lockAngle is { } la) return a + Vec2.FromPolar(dist, la * Math.PI / 180);
      var cur = await JS.InvokeAsync<double[]?>("editor.cursor");
      if (cur is null) return null;
      var dir = new Vec2(cur[0], cur[1]) - a;
      return dir.Length < 1e-12 ? null : a + dir.Normalized() * dist;
    }
    return null;
  }

