  }
  Task Fix() => Run(() => Say(Doc.FixDrawing(Math.Max(Num(FixTol), 1e-9)).ToString()));
  Task SetOverride(int id, string? text) => Run(() => Doc.SetReliefOverride(id, text));
  Task SetDirection(int id, string? dir) => Run(() => Doc.SetReliefDirection(id, string.IsNullOrEmpty(dir) ? null : Enum.Parse<ReliefDir>(dir)));
  Task SetNormal(bool normal) => Run(() => Doc.ReliefNormal = normal);
  static string DirMark(ReliefDir d) => d switch { ReliefDir.Horizontal => "→", ReliefDir.Vertical => "↓", _ => "⊥" };
  Task Deform() => Run(() => Doc.Deform());
  Task DeformAllProfiles() => Run(() =>
  {
    Doc.DeformAll();
    var warnings = Doc.Profiles.Where(p => p.Deformed!.Warnings.Count > 0).Select(p => p.Name).ToList();
    Say($"Calcolati tutti i {Doc.Profiles.Count} profili con le rispettive impostazioni." +
      (warnings.Count > 0 ? $" Controlla gli avvisi di {string.Join(", ", warnings)} nel passo 4 o nel registro." : ""));
  });

  async Task AddProfile()
  {
    Doc.AddProfile(); PullInputs();
    Say($"{Doc.ActiveProfile.Name}: clicca una nuova catena nel disegno. Le impostazioni degli altri profili restano memorizzate.");
    await SetTool("pickxy"); await Push();
  }
  async Task ChangeProfile(ChangeEventArgs e)
  {
    if (!int.TryParse(e.Value?.ToString(), out var id)) return;
    Doc.ActivateProfile(id); PullInputs();
    RegionFlank = RegionFront = RegionDir = "";
    await SetTool("select"); await Push();
    Say($"Stai modificando {Doc.ActiveProfile.Name}. Spoglie e montaggio valgono solo per questo profilo.");
  }
  async Task RemoveProfile()
  {
    await Run(() => { Doc.RemoveActiveProfile(); PullInputs(); });
    if (!StatusIsError) { await SetTool("select"); await Push(); }
  }

  Task ApplyRelief() => Run(() =>
  {
    if (Num(Depth) <= 0) throw new InvalidOperationException("La profondità UV deve essere positiva");
    Doc.Depth = Num(Depth); Doc.FrontCorrectionDeg = Num(Front); Doc.SideClearanceDeg = Num(Side); Doc.FlipMaterial = Flip;
  });
  Task ApplyMounting() => Run(() => { Doc.MountDeg = Num(Mount); Doc.InsertRotDeg = Num(InsertRot); Doc.PivotY = Num(PivotY); });

  /// <summary>"Y +0.1746 mm (8° → 6°)" next to the front correction.</summary>
  string FrontText() => Math.Abs(Doc.FrontCorrectionDeg) < 1e-12 ? "nessuna"
    : $"Y {(Doc.FrontShift.Y >= 0 ? "+" : "")}{F(Doc.FrontShift.Y)} mm ({F(Doc.MountDeg, "0.##")}° → {F(Doc.MountDeg + Doc.FrontCorrectionDeg, "0.##")}°)";

  /// <summary>"frontale −2°, laterale 1° (7)" — what the second profile gives, set or measured.</summary>
  string ReliefSummary()
  {
    var flank = Doc.Relief.Where(r => r.Auto.Kind == EdgeKind.Flank)
                          .Select(r => Doc.UvMode == UvSource.Drawn ? r.Measured?.In(r.Effective.Dir) : r.Effective.AngleDeg)
                          .Where(a => a is not null).Select(a => Math.Round(a!.Value, 2)).ToList();
    string sides = string.Join(", ", flank.GroupBy(a => a).OrderByDescending(g => g.Count()).Select(g => $"{F(g.Key, "0.##")}° ({g.Count()})"));
    double front = Doc.UvMode == UvSource.Drawn ? Doc.MeasuredFrontDeg ?? 0 : Doc.FrontCorrectionDeg;
    return $"{(Doc.UvMode == UvSource.Drawn ? "disegnato, " : "")}frontale {F(front, "0.##")}°, laterale {(sides.Length > 0 ? sides : "nessuna")}";
  }

  async Task HighlightRow(int id)
  {
    HoverId = id;
    await JS.InvokeVoidAsync("editor.highlight", id);
  }

  Task ExportAs(DxfContent what) { ExportWhat = what; ShowExport = false; return Export(); }
  async Task Export()
  {
    string suffix = ExportWhat switch { DxfContent.Deformed => "_DEF", DxfContent.Undeformed => "_NOM", _ => "_DEF_NOM" };
    string what = ExportWhat switch { DxfContent.Deformed => "profili deformati", DxfContent.Undeformed => "profili non deformati", _ => "profili deformati e non deformati" };
    try { var dxf = ExportAllProfiles ? Doc.ExportAllDxf(ExportWhat, Flat) : Doc.ExportDxf(ExportWhat, Flat); await JS.InvokeVoidAsync("editor.download", (Path.GetFileNameWithoutExtension(Doc.FileName) ?? "profilo") + suffix + ".dxf", dxf); Say($"Esportati i {what}: {(ExportAllProfiles ? $"{Doc.Profiles.Count} profili" : Doc.ActiveProfile.Name)} ({suffix[1..]}.dxf)"); }
    catch (Exception ex) { Say(ex.Message, true); }
    await Push();
  }
  async Task ExportDrawing()
  {
    try { var dxf = Doc.ExportDrawingDxf(); await JS.InvokeVoidAsync("editor.download", (Path.GetFileNameWithoutExtension(Doc.FileName) ?? "disegno") + "_EDIT.dxf", dxf); }
    catch (Exception ex) { Say(ex.Message, true); }
  }

  public void Dispose() => _ref?.Dispose();
}
