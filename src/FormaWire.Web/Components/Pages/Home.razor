    var to = new Vec2(xs is null ? old.X : Num(xs.ToString()), ys is null ? old.Y : Num(ys.ToString()));
    await Run(() => { if (KeepConnected) Doc.MoveVertex(old, to); else Doc.MoveEndpoint(id, old, to); });
  }

