    }
  }

  static double Num(string? s) => double.TryParse(s?.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : 0;
  static bool TryNum(string? s, out double v) => double.TryParse(s?.Trim().Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out v);
  static string F(double v, string fmt = "0.####") => v.ToString(fmt, CultureInfo.InvariantCulture);

  void PullInputs()
  {
    Depth = F(Doc.Depth, "0.###"); Side = F(Doc.SideClearanceDeg, "0.###"); Flip = Doc.FlipMaterial;
    Front = F(Doc.FrontCorrectionDeg, "0.###"); Mount = F(Doc.MountDeg, "0.###"); InsertRot = F(Doc.InsertRotDeg, "0.###"); PivotY = F(Doc.PivotY, "0.###");
  }

  async Task Push(bool fit = false)
  {
    await JS.InvokeVoidAsync("editor.setScene", Scene.Build(Doc, ActiveStep == 2), fit);
    StateHasChanged();
  }
  void Refresh() => _ = Push();
  void Say(string text, bool error = false) { Status = text; StatusIsError = error; }

  async Task Run(Action a, bool fit = false)
  {
    Say("");
    try { a(); }
    catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or FormatException or KeyNotFoundException or NotSupportedException)
    { Say(ex.Message, true); Doc.Log.Add("errore: " + ex.Message); }
    await Push(fit);
  }

  bool Uploading;
  async Task OnFile(InputFileChangeEventArgs e)
  {
    if (Uploading) { Say("Attendi il completamento del caricamento in corso.", true); return; }
    if (e.FileCount != 1)
    {
      Say("Apri un file DXF alla volta.", true);
      return;
    }
    if (!e.File.Name.EndsWith(".dxf", StringComparison.OrdinalIgnoreCase))
    {
      Say("Formato non supportato. Apri un file DXF (.dxf).", true);
      return;
    }
    if (e.File.Size > Settings.MaxUploadBytes)
    {
      Say($"File troppo grande. La dimensione massima consentita è {Settings.MaxUploadMB} MB.", true);
      return;
    }
    Uploading = true;
    try
    {
      // Never persist uploads: the bounded browser stream and DXF stay in RAM.
      using var ms = new MemoryStream();
      await using var stream = e.File.OpenReadStream(Settings.MaxUploadBytes);
      await stream.CopyToAsync(ms);
      var text = System.Text.Encoding.Latin1.GetString(ms.GetBuffer(), 0, checked((int)ms.Length));
      Doc.LoadDxf(e.File.Name, text.Split('\n').Select(l => l.TrimEnd('\r')).ToArray());
      PullInputs(); Say(Doc.Upper.Count > 0 ? "Profili trovati nel file — controlla i passi 3 e 4" : "Passo 2: scegli il profilo, o prima sistema il disegno");
      ShowStart = false;
      ActiveStep = Doc.Upper.Count > 0 ? 2 : 1;
    }
    catch (Exception ex) { Say($"{e.File.Name}: {ex.Message}", true); Doc.Log.Add("errore: " + ex.Message); }
    finally { Uploading = false; }
    await SetTool("select");
    await Push(true);
  }

  /// <summary>Start page → an empty sheet with the origin in the middle, ready to draw.</summary>
  async Task StartBlank()
  {
    ActiveStep = 0;
    ShowStart = false;
    Say("Foglio nuovo: l'origine (0,0) è al centro. Disegna il profilo (Linea L, Arco A, Raccorda R…), poi passo 2: Scegli il profilo.");
    await SetTool("line");
    await Push(true);
  }

  /// <summary>Back to the start page; the drawing is cleared (Annulla brings it back).</summary>
  async Task NewDrawing()
  {
    if (Mode3d) await Toggle3d();
    if (Doc.Entities.Count > 0) { Doc.Clear(); Doc.Log.Add("Nuovo disegno (Annulla riporta quello di prima)"); }
    Doc.FileName = null; Doc.Selection.Clear();
    ActiveStep = 0;
    ShowStart = true; ShowExport = false; Say("");
    await SetTool("select");
    await Push(true);
  }

  async Task ToOrigin()
  {
    (string What, bool Moved) r = ("", false);
    await Run(() => r = Doc.ProfileToOrigin(), fit: true);
    if (!StatusIsError) Say(r.Moved ? $"Portato all'origine {r.What}: il punto più a sinistra è a X0, il più alto a Y0" : $"{char.ToUpper(r.What[0])}{r.What[1..]} è già all'origine");
  }

  // ------------------------------------------------------------------ tools and input from the canvas
  async Task SetTool(string t)
  {
    var group = Array.FindIndex(Tools, tools => tools.Any(tool => tool.Key == t));
    if (group >= 0) ToolGroup = group;
    Tool = t; _stretchBox = null; _filletFirst = null; _chamferFirst = null; _arcMid = null; _offsetId = null; ShowExport = false;
    await SetAnchor(null);
    await JS.InvokeVoidAsync("editor.setTool", t, "");
    if (t == "pickuv" || t == "pickxy") await SelectStep(t == "pickxy" ? 1 : 2);
  }
  async Task SetAnchor(Vec2? p)
  {
    _anchor = p; if (p is not null) _last = p;
    _lockAngle = null; _pendingLength = null; _angleEntry = false;
    await JS.InvokeVoidAsync("editor.setAnchor", p is { } q ? new[] { q.X, q.Y } : null);
  }
  async Task PushSnaps() => await JS.InvokeVoidAsync("editor.setSnaps", new { on = SnapsOn, ortho = Ortho, polar = Polar, grid = Grid, end = Snaps["end"], mid = Snaps["mid"], cen = Snaps["cen"], @int = Snaps["int"], perp = Snaps["perp"], near = Snaps["near"], orig = Snaps["orig"] });

  /// <summary>Lock the next segment to an angle; a length typed before Tab places the point straight away.</summary>
  async Task LockAngle(double deg)
  {
    _angleEntry = false; _lockAngle = deg;
    await JS.InvokeVoidAsync("editor.setLock", deg);
    if (_pendingLength is { } len && _anchor is { } a)
    {
      _pendingLength = null;
      var p = a + Vec2.FromPolar(len, deg * Math.PI / 180);
      await OnPoint(p.X, p.Y, true, Tool);
    }
    StateHasChanged();
  }

  /// <summary>Tab in the drawing or the command line: switch between typing the length and the angle of the segment.</summary>
  [JSInvokable] public async Task OnTab(string text)
  {
    Cmd = "";
    if (_anchor is null || Tool is not ("line" or "move" or "copy" or "mirror" or "stretch" or "measure")) { Say("Tab serve a scrivere l'angolo del prossimo tratto: prima metti il suo primo punto"); StateHasChanged(); return; }
    if (_angleEntry)
    {
      if (TryNum(text, out var a)) { await LockAngle(a); return; }
      _angleEntry = false;
    }
    else
    {
      if (TryNum(text, out var len)) _pendingLength = len;
      _angleEntry = true;
    }
    StateHasChanged();
  }
  async Task ToggleSnap(string k) { Snaps[k] = !Snaps[k]; await PushSnaps(); }

  [JSInvokable] public async Task OnPick(int id, bool shift, bool ctrl, string tool)
  {
    if (id >= 0 && !shift && Doc.ProfileContaining(id) is { } owner && owner.Id != Doc.ActiveProfile.Id)
    {
      Doc.ActivateProfile(owner.Id); PullInputs();
      RegionFlank = RegionFront = RegionDir = "";
    }
    if (id < 0) { if (!shift) Doc.Selection.Clear(); }
    else if (tool == "chain") Doc.SelectChain(id, shift);
    else Doc.Select(new[] { id }, additive: false, toggle: shift);
    await Push();
    if (id >= 0 && ActiveStep == 2 && Doc.Upper.Contains(id)) await JS.InvokeVoidAsync("editor.reveal", $"row-{id}");
  }
  [JSInvokable] public async Task OnBoxSelect(int[] ids, bool additive) { Doc.Select(ids, additive: additive); await Push(); }

  [JSInvokable] public async Task OnEntityClick(int id, double x, double y, string tool)
  {
    var p = new Vec2(x, y);
    switch (tool)
    {
      case "chain": await OnPick(id, false, false, "chain"); break;
      case "trim": await Run(() => Doc.Trim(id, p)); break;
      case "extend":
        if (TryNum(ExtendBy, out var by) && by != 0) await Run(() => Doc.ExtendBy(id, p, by));
        else await Run(() => Doc.Extend(id, p));
        break;
      case "break": await Run(() => Doc.Break(id, p)); break;
      case "fillet":
        if (_filletFirst is null) { _filletFirst = (id, p); Doc.Select(new[] { id }); await Push(); }
        else { var (a, pa) = _filletFirst.Value; _filletFirst = null; Doc.Selection.Clear(); await Run(() => Doc.Fillet(a, pa, id, p, Num(FilletR))); }
        break;
      case "chamfer":
        if (_chamferFirst is null) { _chamferFirst = (id, p); Doc.Select(new[] { id }); await Push(); }
        else
        {
          var (a, pa) = _chamferFirst.Value; _chamferFirst = null; Doc.Selection.Clear();
          if (TryChamfer(ChamferD, out var c1, out var c2)) await Run(() => Doc.Chamfer(a, pa, id, p, c1, c2));
          else { Say($"Misura dello smusso '{ChamferD}' non capita: scrivi per esempio 0.5 oppure 0.5;1", true); await Push(); }
        }
        break;
      case "offset":
        _offsetId = id;
        if (OffsetChain) Doc.SelectChain(id); else Doc.Select(new[] { id });
        await JS.InvokeVoidAsync("editor.setTool", "offset", "side");
        await Push();
        break;
      case "align":
        double turned = 0;
        await Run(() => turned = Doc.AlignToAxis(id));
        if (!StatusIsError) Say($"Ruotato di {F(turned, "0.####")}°: la linea ora è {(Doc.Get(id)?.Element is LineSeg al && Math.Abs(al.P1.Y - al.P0.Y) < 1e-9 ? "orizzontale" : "verticale")}");
        break;
      case "startpt":
        if (!Doc.Upper.Contains(id)) { Say("Clicca sul profilo XY (arancione)", true); break; }
        await Run(() => Doc.SetStartPoint(p));
        if (!StatusIsError) { Say("Il profilo XY ora parte da qui (la freccia indica il verso)"); await SetTool("select"); await Push(); }
        break;
      case "pickxy":
        await Run(() => Doc.PickUpper(id), fit: false);
        if (!StatusIsError) { Say($"Profilo utensile: {Doc.Upper.Count} elementi. Passo 3: controlla le spoglie."); Doc.Selection.Clear(); ActiveStep = 2; await SetTool("select"); await Push(); }
        break;
      case "pickuv":
        await Run(() => Doc.PickLower(id));
        if (!StatusIsError) { Say("Secondo profilo scelto: i suoi angoli sono misurati nel passo 3."); Doc.Selection.Clear(); await SetTool("select"); await Push(); }
        break;
    }
  }

  [JSInvokable] public async Task OnPoint(double x, double y, bool snapped, string tool)
  {
    var p = new Vec2(x, y);
    switch (Tool)
    {
      case "origin":
        await Run(() => Doc.PointToOrigin(p), fit: true);
        if (!StatusIsError) Say($"Origine messa nel punto che era {p}");
        await SetTool("select");
        break;
      case "line":
        if (_anchor is { } a0) { await Run(() => Doc.AddLine(a0, p)); if (!StatusIsError) await SetAnchor(p); }
        else await SetAnchor(p);
        break;
      case "arc":
        if (_anchor is not { } s0a) await SetAnchor(p);
        else if (_arcMid is not { } am)
        {
          if (p.AlmostEquals(s0a, 1e-9)) break;
          _arcMid = p; _lockAngle = null; await JS.InvokeVoidAsync("editor.setArcMid", new[] { p.X, p.Y });
        }
        else
        {
          _arcMid = null; await JS.InvokeVoidAsync("editor.setArcMid", null);
          await SetAnchor(null); _last = p;
          await Run(() => Doc.AddArc(s0a, am, p));
        }
        break;
      case "circle":
        if (_anchor is { } cc) { await SetAnchor(null); _last = cc; await Run(() => Doc.AddCircle(cc, p.DistanceTo(cc))); }
        else await SetAnchor(p);
        break;
      case "move":
        if (Doc.Selection.Count == 0) break;
        if (_anchor is { } b) { await SetAnchor(null); var d = p - b; await Run(() => MoveSel(d)); if (!StatusIsError) Say($"Spostato di {d}"); }
        else await SetAnchor(p);
        break;
      case "copy":
        if (Doc.Selection.Count == 0) break;
        if (_anchor is { } cb)
        {
          var d = p - cb;
          await Run(() => Doc.CopySelected(d));
          if (!StatusIsError) Say($"Copiato di {d} — clicca per un'altra copia, Esc per finire");
          await SetAnchor(cb);
        }
        else await SetAnchor(p);
        break;
      case "mirror":
        if (Doc.Selection.Count == 0) break;
        if (_anchor is { } ma) await MirrorAxis(ma, p);
        else await SetAnchor(p);
        break;
      case "scale":
        if (Doc.Selection.Count == 0) break;
        if (_anchor is null) await SetAnchor(p);
        else Say("Scrivi il fattore di scala e Invio (2 = doppio, 0.5 = metà)", true);
        break;
      case "offset":
        if (_offsetId is not { } oid) break;
        _offsetId = null;
        await JS.InvokeVoidAsync("editor.setTool", "offset", "");
        await Run(() => Doc.Offset(oid, p, Num(OffsetD), OffsetChain));
        if (!StatusIsError) Say($"Offset di {OffsetD} mm fatto (selezionato) — clicca un altro elemento o Esc");
        break;
      case "rotate":
        if (Doc.Selection.Count == 0) break;
        if (_anchor is { } c) { await SetAnchor(null); await RotateBy(c, (p - c).Angle * 180 / Math.PI); }
        else await SetAnchor(p);
        break;
      case "stretch":
        if (_stretchBox is not { } box) break;
        if (_anchor is { } s0)
        {
          await SetAnchor(null); _stretchBox = null;
          await Run(() => Doc.Stretch(box.Min, box.Max, p - s0));
          await JS.InvokeVoidAsync("editor.setTool", "stretch", "");
        }
        else await SetAnchor(p);
        break;
      case "measure":
        if (_anchor is { } m0)
        {
          var dd = p - m0;
          Say($"Distanza {F(dd.Length)} · ΔX {F(dd.X)} · ΔY {F(dd.Y)} · angolo {F(dd.Angle * 180 / Math.PI, "0.###")}°");
          Doc.Log.Add($"Misura {m0} → {p}: " + Status);
          await SetAnchor(null);
        }
        else await SetAnchor(p);
        break;
    }
    StateHasChanged();
  }

  async Task RotateBy(Vec2 centre, double deg)
  {
    await Run(() => Doc.RotateSelected(centre, deg));
    if (!StatusIsError) Say($"Ruotato di {F(deg, "0.###")}° attorno a {centre}");
  }

  async Task MirrorAxis(Vec2 a, Vec2 b)
  {
    await SetAnchor(null);
    await Run(() => Doc.MirrorSelected(a, b, MirrorKeep));
    PullInputs();
    if (!StatusIsError) Say(MirrorKeep ? "Copia specchiata fatta (selezionata)" : "Specchiato");
  }

  Task MirrorProfile() => Run(() => { Doc.MirrorProfile(); PullInputs(); Say("Profilo specchiato: destro ↔ sinistro"); });

  /// <summary>"0.5" = the same on both lines, "0.5;1" (or "0.5 1") = first line, second line.</summary>
  static bool TryChamfer(string? text, out double d1, out double d2)
  {
    d1 = d2 = 0;
    var parts = (text ?? "").Split(new[] { ';', ' ' }, StringSplitOptions.RemoveEmptyEntries);
    if (parts.Length is < 1 or > 2 || !TryNum(parts[0], out d1)) return false;
    d2 = d1;
    return parts.Length == 1 || TryNum(parts[1], out d2);
  }

  [JSInvokable] public async Task OnStretchBox(double x0, double y0, double x1, double y1)
  {
    _stretchBox = (new Vec2(x0, y0), new Vec2(x1, y1));
    await JS.InvokeVoidAsync("editor.setTool", "stretch", "points");
    StateHasChanged();
