<?xml version="1.0" encoding="utf-8"?>
<!--
  The repository config clears every package source: the rest of the solution needs no NuGet.
  The WebAssembly build cannot avoid it (the browser runtime ships as packages), so this
  project, and only this project, restores Microsoft's packages from nuget.org.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
